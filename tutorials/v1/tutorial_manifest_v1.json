{
  "schema": "rdp_tutorial_manifest.v1",
  "asset_profile_default": "lm2_baseline",
  "description": "Tutorial gate manifest for the pure V1.0.0 release tree. Labels are release-runner policy, not core solver contracts.",
  "gate_definitions": {
    "v1_smoke": "Fast, stable tutorial run on every release check.",
    "v1_release": "Normal V1 release tutorial; should pass under lm2_baseline.",
    "v1_extended": "Valid V1 tutorial but slower; run for fuller confidence.",
    "v1_showcase_near_solve": "Public demo where exact recovery is not required; near-solve quality must be reported.",
    "v1_slow_demo": "Working demo that is too slow for the default release gate.",
    "optional_lm3": "Valid tutorial that requires 3-gram language-model assets beyond lm2_baseline.",
    "broken_contract_fix_needed": "Tutorial or helper has an API mismatch; exclude until fixed.",
    "wrapper_script_fix_needed": "Wrapper/import script issue; exclude until fixed.",
    "remove_from_pure_release": "Unwanted in pure release tree; remove only after explicit review."
  },
  "asset_profiles": {
    "lm2_baseline": {
      "description": "Minimal useful release profile with 1/2-gram LM assets.",
      "default": true
    },
    "lm3_extended": {
      "description": "Optional profile for tutorials that explicitly require 3-gram LM assets.",
      "default": false
    }
  },
